# Instale com: crontab -e  (ajuste os caminhos)
# Alerta no Telegram a cada 5 minutos
*/5 * * * * cd /home/pi/pm25-iot/server && .venv/bin/python -m scripts.alert_telegram >> data/alert.log 2>&1
# Backup diário às 03:15
15 3 * * * cd /home/pi/pm25-iot/server && .venv/bin/python -m scripts.backup >> data/backup.log 2>&1

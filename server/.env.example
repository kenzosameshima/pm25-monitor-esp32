# Copie para .env e ajuste. Nunca versione o .env.

# Banco SQLite (um único arquivo)
PM25_DB_PATH=data/pm25.db

# Um token por nó, no formato id:token, separados por vírgula (mínimo de 16 caracteres).
# Gere tokens com: python -c "import secrets; print(secrets.token_urlsafe(24))"
PM25_DEVICE_TOKENS=no-01:TROQUE-este-token-do-no-01,no-02:TROQUE-este-token-do-no-02

# Backups diários. Aponte para um pendrive ou pasta sincronizada, não para o mesmo cartão SD.
PM25_BACKUP_DIR=backups
PM25_BACKUP_KEEP=14

# Alerta no Telegram (crie o bot com o @BotFather; deixe vazio para só imprimir as mensagens)
PM25_TELEGRAM_TOKEN=
PM25_TELEGRAM_CHAT_ID=
PM25_ALERT_SILENCE_MIN=15
PM25_ALERT_STATE=data/alert_state.json

# Proteções da API exposta na internet (valores padrão)
# Tamanho máximo do corpo de uma requisição, em bytes (um lote de 500 leituras ocupa cerca de 125 KiB).
PM25_MAX_BODY_BYTES=262144
# Após N falhas de autenticação seguidas, o IP recebe 429 por alguns minutos; uma autenticação válida zera a contagem.
PM25_AUTH_MAX_FAILS=10
PM25_AUTH_BLOCK_MIN=5

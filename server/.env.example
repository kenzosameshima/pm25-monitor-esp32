# Copie para .env e ajuste. Nunca versione o .env.

# Banco SQLite (um único arquivo)
PM25_DB_PATH=data/pm25.db

# Um token por nó, no formato id:token, separados por vírgula (mínimo de 16 caracteres).
# Gere tokens com: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Os valores abaixo são só exemplo: a API se recusa a iniciar com tokens que contenham "TROQUE".
PM25_DEVICE_TOKENS=no-01:TROQUE-este-token-do-no-01,no-02:TROQUE-este-token-do-no-02

# Token do app de consulta (rotas GET /v1/devices...), diferente dos tokens dos nós: um nó não lê e o
# app não grava. Vazio deixa as rotas de leitura desligadas (respondem 503).
PM25_READ_TOKEN=

# Backups diários. Aponte para um pendrive ou pasta sincronizada, não para o mesmo cartão SD.
PM25_BACKUP_DIR=backups
PM25_BACKUP_KEEP=14

# Modelos de previsão (um .joblib por modelo, gerados por scripts.fit_forecast) usados pelo job horário
PM25_MODELS_DIR=data/models

# Proteções da API exposta na internet (valores padrão)
# Tamanho máximo do corpo de uma requisição, em bytes (um lote de 500 leituras ocupa cerca de 125 KiB).
PM25_MAX_BODY_BYTES=262144
# Após N falhas de autenticação em BLOCK_MIN minutos, o IP recebe 429 nas tentativas inválidas por BLOCK_MIN
# minutos; o token correto continua aceito, e acertar não zera a contagem (as falhas expiram sozinhas).
PM25_AUTH_MAX_FAILS=10
PM25_AUTH_BLOCK_MIN=5

{
  "name": "BME280",
  "author": "Kenzo Sameshima (@kenzosameshima)",
  "pins": ["GND", "VCC", "SCL", "SDA", "", "", "", ""],
  "controls": [
    {
      "id": "temp",
      "label": "Temperature (°C)",
      "type": "range",
      "min": -40,
      "max": 85,
      "step": 0.5,
      "default": 25
    },
    {
      "id": "press",
      "label": "Pressure (hPa)",
      "type": "range",
      "min": 300,
      "max": 1100,
      "step": 1,
      "default": 1013
    },
    {
      "id": "hum",
      "label": "Humidity (%RH)",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    }
  ]
}

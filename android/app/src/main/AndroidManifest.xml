<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Só é pedida quando a API está na rede local (emulador ou servidor na mesma rede); ver LocalNetworkGate. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Alertas em segundo plano (Android 13 ou mais novo); pedida pelo cartão da tela inicial. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sem backup: o que o app guarda é cache e o estado dos alertas, que restaurado em outro aparelho
         esconderia avisos que ainda não foram dados lá. O token de leitura não fica em arquivo. -->
    <application
        android:name=".Pm25Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
